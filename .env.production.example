# Copy to .env and replace every placeholder before deployment. Never commit .env.
POSTGRES_DB=inspection_platform
POSTGRES_USER=inspection
DB_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_RANDOM_DATABASE_PASSWORD
SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
ALLOWED_HOSTS=inspection.example.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://inspection.example.com
# REQUIRED: terminate TLS at a trusted reverse proxy/load balancer in front of this stack.
# Forward X-Forwarded-Proto=https only from that trusted proxy; never expose backend directly.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
HTTP_PORT=127.0.0.1:8080
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
LOG_LEVEL=INFO

# Database transport encryption when connecting to a remote PostgreSQL service
DB_SSL_REQUIRE=false
# DR backup retention is enforced by the backup scheduler, not by this app
BACKUP_DIR=/backups

# Number of reverse proxies in front of Django (nginx + your TLS terminator = 2). Needed for correct
# client IPs in audit logs and per-IP throttling; wrong values let clients spoof their address.
NUM_PROXIES=2
# Alert recipients for overdue reports / NCRs / expiring certificates (comma separated)
ADMIN_EMAILS=quality@example.com
SERVER_EMAIL=noreply@example.com
# Use an unguessable admin path, e.g. manage-7f3a9c/
ADMIN_URL=admin/
BACKUP_HOST_DIR=./backups

# Security integrations
# When true, internal roles must enrol TOTP before any other API call works.
INTERNAL_2FA_REQUIRED=false
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=20

# Bearer token Prometheus must send to /metrics/ (empty = metrics endpoint disabled). Generate: python scripts/generate_secret.py
METRICS_TOKEN=
# Start ClamAV with:  docker compose -f docker-compose.production.yml --profile scan up -d  (then MALWARE_SCAN_ENABLED=true)
